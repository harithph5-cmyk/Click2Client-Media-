# Copy to .env (or set in your host's panel). Never commit real values.
PORT=3000
NODE_ENV=production          # enables Secure cookies + HTTPS upgrade
DATA_DIR=./data              # SQLite DB + private uploads live here; back it up, keep it OUTSIDE public/
# Optional analytics (loaded only after the visitor accepts the consent banner)
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
