# ─── Click2Client Media — environment configuration ─────────────────────
# Copy to .env and fill in what you need. Never commit .env.

PORT=3000

# ── Database (REQUIRED) ──
# PostgreSQL connection string. The app checks, in order:
#   1. database_POSTGRES_URL — created automatically on Vercel by the Neon
#      integration (Storage tab, env prefix "database_"). Nothing to add there.
#   2. DATABASE_URL          — use this for local development (paste a Neon
#      connection string, ideally from a separate "dev" branch).
# The app never stores data on the local filesystem.
DATABASE_URL=
# AUDIT_TIME_BUDGET_MS=270000   # must stay below the function limit (300 s)
NODE_ENV=production
# Your live domain — used for canonical URLs, sitemap, Open Graph and report emails
PUBLIC_URL=https://click2clientmedia.com

# ── Admin portal (/admin) ──
# Default password is 2004. CHANGE THIS before going live — a 4-digit
# password is easy to guess. Best: generate a hash and use ADMIN_PASSWORD_HASH:
#   node -e "import('./server/security/auth.js').then(m=>console.log(m.hashPassword('your-long-password')))"
ADMIN_PASSWORD=2004
# ADMIN_PASSWORD_HASH=scrypt$...$...
# ADMIN_SESSION_HOURS=8

# ── Audit prices in rupees (server-side only; browsers can't change these) ──
PRICE_25_PAGE_AUDIT=125
PRICE_50_PAGE_AUDIT=399

# ── Contact defaults (also editable in Admin → Settings) ──
CONTACT_PHONE=+91 99404 11837
WHATSAPP_NUMBER=919940411837
CONTACT_EMAIL=harithph5@gmail.com
INSTAGRAM_URL=https://www.instagram.com/click2client_media/?hl=en
FACEBOOK_URL=https://www.facebook.com/profile.php?id=61589983354793
# UPI_ID=yourname@upi
# UPI_PAYEE_NAME=Click2Client Media

# ── Google PageSpeed Insights (strongly recommended) ──
# Free key: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ── AI consultant notes on paid reports (optional) ──
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# ── Email: report-ready emails + new lead alerts (optional, Resend) ──
# RESEND_API_KEY=
# EMAIL_FROM="Click2Client Media <reports@click2clientmedia.com>"
# NOTIFY_EMAIL=harithph5@gmail.com

# ── Lead webhook to a CRM / Google Sheets / Zapier (optional) ──
# LEAD_WEBHOOK_URL=

# ── Backlinks (optional; never estimated) ──
# BACKLINK_PROVIDER=dataforseo
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# ── Crawler tuning ──
# CRAWLER_TIMEOUT_MS=15000
# CRAWLER_CONCURRENCY=3
# LINK_CHECK_LIMIT=60
# MAX_PAGES_CEILING=100
