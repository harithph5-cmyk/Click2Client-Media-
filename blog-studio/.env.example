# Copy to blog-studio/.env  (git-ignored). Never commit real values.

# Portal login (required)
STUDIO_EMAIL=you@example.com
STUDIO_PASSWORD=choose-a-long-password
STUDIO_SECRET=any-long-random-string      # keeps you signed in across restarts
# STUDIO_PORT=4300
# STUDIO_HOST=127.0.0.1                   # keep local unless you add HTTPS in front

# Website connection — the SAME token must be set as BLOG_API_TOKEN on the website
SITE_URL=https://click2clientmedia.com
BLOG_API_TOKEN=generate-with-node-e-"console.log(crypto.randomBytes(32).toString('hex'))"

# AI (either or both: ChatGPT via OpenAI, or Gemini)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional Google (service account; add its email to Search Console + GA4)
GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON=
